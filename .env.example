NEXT_PUBLIC_BACKEND=local

# Set NEXT_PUBLIC_BACKEND=google (and fill in every var below) to switch
# from local-only (localStorage, default) to a real Google Sheets + Drive
# backend. See docs/superpowers/plans/2026-07-14-google-backend-migration.md
# Part B for the full setup checklist.
# NOTE: NEXT_PUBLIC_BACKEND and SPREADSHEET_ID must be changed together —
# setting only one leaves the app in an inconsistent half-on state.
# NOTE: the app has no login wall in either mode (middleware.ts is a
# no-op by design). ALLOWED_EMAILS/AUTH_SECRET/AUTH_URL below are unused
# leftovers from auth.ts's NextAuth setup, kept only in case login is
# re-enabled later — they don't need to be filled in for Google mode to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SPREADSHEET_ID=
DRIVE_ROOT_FOLDER_ID=
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/<id>
